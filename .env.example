# URL da API do Classroom (FastAPI)
# No emulador Android, o padrão já faz fallback para http://10.0.2.2:8000
# No iOS Simulator / Web, o padrão é http://localhost:8000
# Para dispositivos físicos na mesma rede Wi-Fi, use o IP da sua máquina: http://192.168.x.x:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
